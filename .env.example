# Dream Decorators ERP - Root Environment Configuration Template

# Application Runtime
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection (Neon / Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dream_decorators_erp?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dream_decorators_erp?schema=public"

# Authentication & JWT Security
JWT_SECRET=supersecret_jwt_key_dream_decorators_2026_change_in_prod
JWT_EXPIRES_IN=7d

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=info

# Frontend Client Public API URL
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
